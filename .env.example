# Copy to .env and fill in. Never commit .env.

DATA_DIR=data

# Interactive Brokers Gateway (localhost socket; no API key)
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=17
IB_ACCOUNT=

# Sleeve capital for this bot (USD). Required for check / serve.
ALLOCATED_USD=

# paper | live. Real orders need LIVE_ARMED=true and DRY_RUN=false.
LIVE_MODE=paper
LIVE_ARMED=false
DRY_RUN=true

# Telegram (dedicated bot; do not reuse the ORB bot token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional dead-man ping (healthchecks.io)
HEALTHCHECK_URL=
