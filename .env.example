# Copy to .env and fill in. Never commit .env.

DATA_DIR=data

# Default sleeve when --sleeve is omitted (tqqq | goog)
SLEEVE=tqqq

# Interactive Brokers Gateway (localhost socket; no API key)
IB_HOST=127.0.0.1
IB_PORT=4002
# Leave unset to use per-sleeve client ids from config/sleeves.yaml
IB_CLIENT_ID=
# Watchlist process (rsi-bot watch) only; must differ from every sleeve and OrbBot
WATCH_IB_CLIENT_ID=77
IB_ACCOUNT=

# Optional override of the active sleeve's allocated_usd
ALLOCATED_USD=

# paper | live. Real orders need LIVE_ARMED=true and DRY_RUN=false.
LIVE_MODE=paper
LIVE_ARMED=false
DRY_RUN=true

# Telegram (dedicated bot; RsiCrossCtrl polls; sleeve serves only send)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional dead-man ping (healthchecks.io)
HEALTHCHECK_URL=
